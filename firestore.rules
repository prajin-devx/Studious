rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health / connection test document check
    match /test/{testId} {
      allow read: if isSignedIn() && isValidId(testId);
      allow write: if false;
    }

    // User-isolated academic workspace
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /{collectionName}/{docId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }
    }
  }
}
